[ req ]
distinguished_name = subject
prompt = no
req_extensions = service_extensions

[ subject ]
CN = fake-idp
O = AWP Local Development

[ service_extensions ]
subjectAltName = @service_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[ service_names ]
DNS.1 = fake-idp
DNS.2 = localhost
IP.1 = 127.0.0.1
