# Только локальная разработка; Node не загружает этот файл автоматически.
# Env реального деплоя: docs/deployment/templates/runtime.env.example
# Справочник локальных env: docs/runbooks/local-environment.md
# Для pnpm dev:pilot:up файл не нужен: настройки задают launcher и Compose.
# localhost:5432 предполагает отдельно подготовленную БД: Compose не публикует этот порт.
# fake-idp — имя внутри Docker-сети; для host-запуска нужен доступный OIDC issuer.
AWP_RUNTIME_PROFILE=local
# Базовая composition без QA. Полный pilot явно выбирает свой состав расширений.
AWP_COMPOSITION=foundation
AWP_DATABASE_URL=postgresql://awp_local:local-only@localhost:5432/awp
AWP_MOCK_HUB_URL=http://localhost:4010
AWP_IDENTITY_ISSUER=https://fake-idp:4443/oidc
AWP_IDENTITY_AUDIENCE=awp-local
AWP_EXTERNAL_NETWORK_MODE=deny
AWP_MODEL_PROVIDER=deterministic-fake
