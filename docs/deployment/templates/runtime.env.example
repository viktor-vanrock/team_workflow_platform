# Шаблон реального корпоративного NON_PROD-стенда.
# Инструкция: docs/deployment/configuration.md, готовность сборки: docs/deployment/README.md.
# Требует заполненной policy и корпоративных host adapters; сам файл не запускает деплой.
# Node читает process.env, файл автоматически не загружается.
# Credentials доставляются через secret store; заполненные секреты не коммитятся.

# Обязательная конфигурация API И worker.
AWP_ENVIRONMENT=NON_PROD
AWP_COMPOSITION=qa-jira-gitlab-mattermost-test
AWP_EXTERNAL_NETWORK_MODE=allowlisted
# Одинаковое СОДЕРЖИМОЕ JSON опубликованной DeploymentPolicy, не путь к файлу.
AWP_DEPLOYMENT_CONFIG=
# DSN корпоративной PostgreSQL с runtime credentials и настроенным TLS.
# Для migration job используется отдельная роль. AWP_DATABASE_URL_FILE не поддерживается.
AWP_DATABASE_URL=
# HTTPS issuer, точно совпадающий с endpoint identity.url в policy, и audience IdP.
AWP_IDENTITY_ISSUER=
AWP_IDENTITY_AUDIENCE=

# Только API: публичный HTTPS origin web для CORS.
AWP_WEB_ORIGIN=

# Необязательные явные значения API/worker; обязаны согласовываться с policy/окружением.
AWP_DEPLOYMENT_PROFILE=integration
AWP_RUNTIME_PROFILE=non-local
# Ключ реальной модели, если используется; policy/credentials/adapter нужны отдельно.
# AWP_MODEL_PROVIDER=

# Необязательные порты: PORT передать только API, WORKER_HEALTH_PORT — worker.
PORT=3000
WORKER_HEALTH_PORT=3010

# Отдельная конфигурация СБОРКИ web: эти значения попадут в browser bundle.
# VITE_AWP_COMPOSITION=qa-jira-gitlab-mattermost-test
# VITE_AWP_API_URL=
# VITE_AWP_AUTH_MODE=corporate

# Corporate host: createCorporateSessionBindings включает accessProvisioning по умолчанию.
# Первый проверенный корпоративный вход получает глобальную роль администратора один раз.
# Группы Keycloak не требуются; core migration 225 обязательна. См. corporate-access.md.

# Отдельная конфигурация Collector; это не telemetry bindings API/worker.
# AWP_TELEMETRY_BACKEND_ORIGIN=

# Локальные mocks, статические test contours и локальные signing keys здесь не используются.
# Режим CI artifacts в v1 — GITLAB_ONLY; env для платформенного object storage не требуется.
