{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:007:target-snapshot:v2",
  "title": "Exact QA target snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "version", "workspaceId", "projectId", "workItemId", "sessionId", "mode", "sourceRefs", "buildRef", "environmentRef", "testDataRefs", "accountLeaseRefs", "definitionRefs", "configurationPins", "policyRefs", "modeConfiguration", "capturedAt", "contentHash"],
  "properties": {
    "schemaVersion": { "const": "qa-target-snapshot@2.0.0" },
    "snapshotId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "version": { "const": 1 },
    "workspaceId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "projectId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "workItemId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sessionId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "mode": { "enum": ["MANUAL", "AUTOMATED"] },
    "sourceRefs": { "$ref": "#/$defs/refSet" },
    "buildRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
    "environmentRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
    "testDataRefs": { "$ref": "#/$defs/refSet" },
    "accountLeaseRefs": { "$ref": "#/$defs/refSet" },
    "definitionRefs": { "$ref": "#/$defs/refSet" },
    "configurationPins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "logicalRole", "capabilityKey", "exactContractVersion", "bindingRef", "profileRef", "connectionRef", "validationReportRef", "operationSetHash", "externalScopeHash"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0 },
          "logicalRole": { "$ref": "../common.v1.schema.json#/$defs/stableKey" },
          "capabilityKey": { "$ref": "../common.v1.schema.json#/$defs/stableKey" },
          "exactContractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "bindingRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
          "profileRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
          "connectionRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
          "mappingRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
          "validationReportRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
          "operationSetHash": { "$ref": "../common.v1.schema.json#/$defs/hash" },
          "externalScopeHash": { "$ref": "../common.v1.schema.json#/$defs/hash" }
        }
      }
    },
    "policyRefs": { "$ref": "#/$defs/refSet" },
    "modeConfiguration": { "$ref": "../common.v1.schema.json#/$defs/schemaBoundValue" },
    "capturedAt": { "$ref": "../common.v1.schema.json#/$defs/timestamp" },
    "contentHash": { "$ref": "../common.v1.schema.json#/$defs/hash" }
  },
  "$defs": {
    "refSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "../common.v1.schema.json#/$defs/exactRef" }
    }
  }
}
