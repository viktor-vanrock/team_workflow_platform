{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:007:evidence-package:v1",
  "title": "QA Work Item evidence package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "version", "workspaceId", "projectId", "workItemId", "manifestRevisionRefs", "signatureRefs", "qaVerdictRef", "residualRiskHash", "packagePolicyRef", "createdBy", "createdAt", "contentHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "workspaceId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "projectId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "workItemId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "manifestRevisionRefs": { "$ref": "#/$defs/nonEmptyRefSet" },
    "signatureRefs": { "$ref": "#/$defs/nonEmptyRefSet" },
    "qaVerdictRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
    "residualRiskHash": { "$ref": "../common.v1.schema.json#/$defs/hash" },
    "packagePolicyRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
    "createdBy": { "$ref": "../common.v1.schema.json#/$defs/humanActor" },
    "createdAt": { "$ref": "../common.v1.schema.json#/$defs/timestamp" },
    "contentHash": { "$ref": "../common.v1.schema.json#/$defs/hash" }
  },
  "$defs": {
    "nonEmptyRefSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "../common.v1.schema.json#/$defs/exactRef" }
    }
  }
}
