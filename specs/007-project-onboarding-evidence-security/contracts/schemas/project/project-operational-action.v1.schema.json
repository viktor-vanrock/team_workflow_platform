{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:007:project-operational-action:v1",
  "title": "Project operational action candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actionId", "workspaceId", "projectId", "action", "expectedOnboardingVersion", "incidentRef", "reason", "initiator", "correlationId", "createdAt", "expiresAt", "contentHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "actionId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "workspaceId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "projectId": { "$ref": "../common.v1.schema.json#/$defs/uuid" },
    "action": { "enum": ["EMERGENCY_SUSPEND", "RESUME"] },
    "expectedOnboardingVersion": { "type": "integer", "minimum": 1 },
    "incidentRef": { "$ref": "../common.v1.schema.json#/$defs/nonEmpty" },
    "incidentDispositionRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
    "freshProbeRefs": {
      "type": "array",
      "items": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
      "uniqueItems": true
    },
    "approvalRef": { "$ref": "../common.v1.schema.json#/$defs/exactRef" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "initiator": { "$ref": "../common.v1.schema.json#/$defs/humanActor" },
    "correlationId": { "$ref": "../common.v1.schema.json#/$defs/correlationId" },
    "createdAt": { "$ref": "../common.v1.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "../common.v1.schema.json#/$defs/timestamp" },
    "contentHash": { "$ref": "../common.v1.schema.json#/$defs/hash" }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "RESUME" } }, "required": ["action"] },
      "then": { "required": ["incidentDispositionRef", "freshProbeRefs", "approvalRef"] }
    }
  ]
}
