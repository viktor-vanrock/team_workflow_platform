{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:contracts:pilot:gate-report:v1",
  "title": "Feature 008 gate report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "feature",
    "runId",
    "gate",
    "status",
    "deploymentProfile",
    "scope",
    "startedAt",
    "finishedAt",
    "fingerprints",
    "executorIdentity",
    "checks",
    "prerequisites",
    "reasonCodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "feature": {
      "const": "008-pilot-hardening-and-conformance"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "enum": [
        "prerequisites",
        "setup",
        "foundation",
        "us1",
        "us2",
        "us3",
        "us4",
        "us5",
        "local",
        "inputs",
        "integration",
        "security",
        "recovery",
        "shadow",
        "limited-pilot",
        "review"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_INPUT",
        "SKIPPED_GATED"
      ]
    },
    "deploymentProfile": {
      "enum": [
        "local",
        "integration",
        "pilot"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "projectIds"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "projectIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "contracts",
        "migrations",
        "lockfile",
        "configuration",
        "inputs",
        "suite"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contracts": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "migrations": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lockfile": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configuration": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inputs": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "suite": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scannerDatabase": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "executorIdentity": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence",
          "reasonCodes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED_INPUT",
              "SKIPPED_GATED"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          },
          "reasonCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "measurementsRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "reasonCodes": {
            "maxItems": 0
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                },
                "evidence": {
                  "minItems": 1
                },
                "reasonCodes": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "reasonCodes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
