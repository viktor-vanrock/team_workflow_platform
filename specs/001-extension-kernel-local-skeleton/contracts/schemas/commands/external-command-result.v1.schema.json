{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:contracts:commands:external-command-result:v1",
  "title": "Normalized External Command Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcome", "completedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "outcome": { "type": "string", "enum": ["SUCCEEDED", "CONFLICT", "FAILED"] },
    "confirmationMode": {
      "type": "string",
      "enum": ["SYNC_RECEIPT", "READ_BACK", "WEBHOOK", "RECONCILIATION"]
    },
    "completedAt": { "type": "string", "format": "date-time" },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectId"],
      "properties": {
        "effectId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "externalEntityId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "externalDisplayKey": { "type": "string", "minLength": 1, "maxLength": 255 },
        "externalVersion": { "type": "string", "minLength": 1, "maxLength": 255 },
        "result": { "$ref": "../common/schema-bound-value.v1.schema.json" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryClass"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
        "retryClass": { "type": "string", "enum": ["NEVER", "TRANSIENT", "RECONCILE"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "SUCCEEDED" } },
        "required": ["outcome"]
      },
      "then": {
        "required": ["confirmationMode", "receipt"],
        "not": { "required": ["error"] }
      },
      "else": { "required": ["error"] }
    }
  ]
}
