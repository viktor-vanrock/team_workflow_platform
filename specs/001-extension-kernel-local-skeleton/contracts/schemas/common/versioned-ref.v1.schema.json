{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:contracts:common:versioned-ref:v1",
  "title": "AWP Versioned References",
  "$defs": {
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "SemVerRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "StableKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9][a-z0-9-]*)*$",
      "maxLength": 128
    },
    "LogicalRoleKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "ComponentRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.:/-][a-z0-9][a-z0-9-]*)+$",
      "maxLength": 192
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^urn:awp:schemas:[A-Za-z0-9:._-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/Digest" }
      }
    },
    "IntegerVersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "SemanticVersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version"],
      "properties": {
        "key": { "$ref": "#/$defs/StableKey" },
        "version": { "$ref": "#/$defs/SemVer" }
      }
    },
    "EnvironmentScope": {
      "type": "string",
      "enum": ["LOCAL", "NON_PROD", "PREPROD", "PLATFORM_PROD"]
    }
  }
}
