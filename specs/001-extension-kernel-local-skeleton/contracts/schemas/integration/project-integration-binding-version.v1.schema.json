{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:contracts:integration:project-integration-binding-version:v1",
  "title": "Project Integration Binding Version",
  "description": "Core contract contains only generic typed capability entries. Pack-specific suite or domain configuration is not embedded here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bindingId",
    "workspaceId",
    "projectId",
    "dataClassificationKey",
    "version",
    "state",
    "entries",
    "schemaVersion",
    "contentHash",
    "resourceVersion",
    "createdAt"
  ],
  "properties": {
    "bindingId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "dataClassificationKey": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "version": { "type": "integer", "minimum": 1 },
    "state": { "type": "string", "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "RETIRED"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/BindingEntry" }
    },
    "configurationRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/SchemaBoundResourceRef" }
    },
    "resourceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/SchemaBoundResourceRef" }
    },
    "schemaVersion": { "const": 1 },
    "contentHash": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/Digest" },
    "resourceVersion": { "type": "integer", "minimum": 1 },
    "validationReportId": {
      "description": "Exact successful immutable Validation Report that authorized the transition out of DRAFT; excluded from contentHash to avoid a circular fingerprint.",
      "type": "string",
      "format": "uuid"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "validatedAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "retiredAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "VALIDATED" } }, "required": ["state"] },
      "then": { "required": ["validationReportId", "validatedAt"] }
    },
    {
      "if": { "properties": { "state": { "const": "PUBLISHED" } }, "required": ["state"] },
      "then": { "required": ["validationReportId", "validatedAt", "publishedAt"] }
    },
    {
      "if": { "properties": { "state": { "const": "RETIRED" } }, "required": ["state"] },
      "then": { "required": ["validationReportId", "validatedAt", "publishedAt", "retiredAt"] }
    },
    {
      "if": { "properties": { "state": { "const": "DRAFT" } }, "required": ["state"] },
      "then": { "not": { "anyOf": [{ "required": ["validationReportId"] }, { "required": ["validatedAt"] }, { "required": ["publishedAt"] }, { "required": ["retiredAt"] }] } }
    },
    {
      "if": { "properties": { "state": { "const": "VALIDATED" } }, "required": ["state"] },
      "then": { "not": { "anyOf": [{ "required": ["publishedAt"] }, { "required": ["retiredAt"] }] } }
    },
    {
      "if": { "properties": { "state": { "const": "PUBLISHED" } }, "required": ["state"] },
      "then": { "not": { "required": ["retiredAt"] } }
    }
  ],
  "$defs": {
    "BindingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalRole",
        "capabilityKey",
        "exactContractVersion",
        "environmentScope",
        "classificationCeilingKey",
        "profileRef",
        "externalScope"
      ],
      "properties": {
        "logicalRole": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/LogicalRoleKey" },
        "capabilityKey": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/StableKey" },
        "exactContractVersion": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/SemVer" },
        "environmentScope": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/EnvironmentScope" },
        "classificationCeilingKey": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "profileRef": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/IntegerVersionRef" },
        "externalScope": { "$ref": "../common/schema-bound-value.v1.schema.json" }
      }
    },
    "SchemaBoundResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "schemaRef", "resourceRef", "contentHash"],
      "properties": {
        "key": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/StableKey" },
        "schemaRef": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/SchemaRef" },
        "resourceRef": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/IntegerVersionRef" },
        "contentHash": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/Digest" }
      }
    }
  }
}
