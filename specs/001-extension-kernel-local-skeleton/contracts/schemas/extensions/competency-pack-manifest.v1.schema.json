{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:contracts:extensions:competency-pack-manifest:v1",
  "title": "Competency Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "requires", "workTypes", "events"],
  "properties": {
    "apiVersion": { "const": "awp.platform/v1" },
    "kind": { "const": "CompetencyPack" },
    "metadata": { "$ref": "#/$defs/Metadata" },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreContracts", "competencySdk"],
      "properties": {
        "coreContracts": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/SemVerRange" },
        "competencySdk": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/SemVerRange" }
      }
    },
    "workTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "./work-type-definition.v1.schema.json" }
    },
    "events": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventType", "payloadVersion", "payloadSchemaRef"],
        "properties": {
          "eventType": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/StableKey" },
          "payloadVersion": { "type": "integer", "minimum": 1 },
          "payloadSchemaRef": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/SchemaRef" }
        }
      }
    }
  },
  "$defs": {
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "displayName"],
      "properties": {
        "key": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/StableKey" },
        "version": { "$ref": "../common/versioned-ref.v1.schema.json#/$defs/SemVer" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
