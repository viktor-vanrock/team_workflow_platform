{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:004:events:agent-action-denied:v1",
  "title": "Agent Action Denied Event Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "toolKey",
    "operation",
    "reasonCode",
    "actionProvenanceRef"
  ],
  "properties": {
    "toolKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "actionProvenanceRef": {
      "$ref": "#/$defs/ref"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
