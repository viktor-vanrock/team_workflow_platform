{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:004:events:agent-run-started:v1",
  "title": "Agent Run Started Event Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "subject",
    "skillRef",
    "inputFingerprint",
    "grantSetHash",
    "actionProvenanceRef"
  ],
  "properties": {
    "state": {
      "const": "VALIDATING_INPUT"
    },
    "subject": {
      "$ref": "#/$defs/agentSubject"
    },
    "skillRef": {
      "$ref": "#/$defs/versionedHashRef"
    },
    "inputFingerprint": {
      "$ref": "#/$defs/digest"
    },
    "grantSetHash": {
      "$ref": "#/$defs/digest"
    },
    "actionProvenanceRef": {
      "$ref": "#/$defs/ref"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "versionedHashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "hash"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "hash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "agentSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "contentHash"
      ],
      "properties": {
        "kind": {
          "enum": [
            "DRAFT",
            "CANDIDATE",
            "WORK_ITEM"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
