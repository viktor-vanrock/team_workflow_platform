{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:004:events:intake-candidate-source-observed:v1",
  "title": "Intake Candidate Source Observed Event Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observationVersion",
    "sourceEntityVersion",
    "sourceFingerprint",
    "triggerEvaluationHash",
    "actionProvenanceRef"
  ],
  "properties": {
    "observationVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sourceEntityVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceFingerprint": {
      "$ref": "#/$defs/digest"
    },
    "triggerEvaluationHash": {
      "$ref": "#/$defs/digest"
    },
    "actionProvenanceRef": {
      "$ref": "#/$defs/ref"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
