{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:004:intake-draft-revision:v1.1",
  "title": "IntakeDraftRevision v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "draftId",
    "revisionId",
    "revision",
    "workspaceId",
    "projectId",
    "requesterPrincipalId",
    "intakeSchemaRef",
    "workTypeRef",
    "content",
    "contentHash",
    "sourceKind",
    "actionProvenanceRef",
    "validation",
    "createdBy",
    "createdAt",
    "correlationId",
    "causationId"
  ],
  "properties": {
    "schemaVersion": { "const": "intake-draft-revision@1.1.0" },
    "draftId": { "$ref": "#/$defs/id" },
    "revisionId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "workspaceId": { "$ref": "#/$defs/id" },
    "projectId": { "$ref": "#/$defs/id" },
    "originCandidateId": { "$ref": "#/$defs/id" },
    "requesterPrincipalId": { "$ref": "#/$defs/id" },
    "previousRevisionId": { "$ref": "#/$defs/id" },
    "previousContentHash": { "$ref": "#/$defs/hash" },
    "intakeSchemaRef": { "$ref": "#/$defs/qaIntakeSchemaRef" },
    "workTypeRef": { "$ref": "#/$defs/versionedHashRef" },
    "content": { "$ref": "urn:awp:schemas:004:qa-intake-partial-content:v1" },
    "contentHash": { "$ref": "#/$defs/hash" },
    "sourceKind": { "enum": ["HUMAN_FORM", "MATTERMOST_ACTION", "HERMES_PROPOSAL_ACCEPTED", "DETERMINISTIC_NORMALIZATION"] },
    "sourceMessageRef": { "type": "string", "minLength": 1, "maxLength": 512 },
    "actionProvenanceRef": { "type": "string", "minLength": 1, "maxLength": 512 },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rulesRef", "inputHash", "state", "blockers"],
      "properties": {
        "rulesRef": { "$ref": "#/$defs/versionedHashRef" },
        "inputHash": { "$ref": "#/$defs/hash" },
        "state": { "enum": ["VALID", "INCOMPLETE", "INVALID"] },
        "blockers": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "allOf": [
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "VALID" } } },
          "then": { "properties": { "blockers": { "type": "array", "maxItems": 0 } } },
          "else": { "properties": { "blockers": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "createdBy": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "correlationId": { "$ref": "#/$defs/id" },
    "causationId": { "$ref": "#/$defs/id" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["revision"],
        "properties": { "revision": { "const": 1 } }
      },
      "then": {
        "type": "object",
        "properties": {
          "previousRevisionId": false,
          "previousContentHash": false
        }
      },
      "else": {
        "type": "object",
        "required": ["previousRevisionId", "previousContentHash"]
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["validation"],
        "properties": {
          "validation": {
            "type": "object",
            "required": ["state"],
            "properties": { "state": { "const": "VALID" } }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "content": {
            "type": "object",
            "required": ["schemaVersion", "title", "requestKind", "requestedClassificationKey"],
            "properties": {
              "schemaVersion": true,
              "title": true,
              "requestKind": true,
              "requestedClassificationKey": true
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "qaIntakeSchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "const": "urn:awp:schemas:qa:intake:v1" },
        "version": { "const": 1 },
        "digest": { "const": "sha256:ad12fce95a79e073efd7a4d853db05628211104a93e330d5455a81c2fab54837" }
      }
    },
    "versionedHashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "hash"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$", "maxLength": 64 },
        "hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
