{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:005:automation-attempt-result:v1",
  "title": "AutomationAttemptResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "automationAttemptResultId",
    "workspaceId",
    "projectId",
    "automationAttemptId",
    "normalizationKind",
    "outcome",
    "resultSchemaRef",
    "normalizationReport",
    "normalizedResultHash",
    "suiteKey",
    "environmentRef",
    "artifactDescriptorSetHash",
    "artifactSyncState",
    "terminalAt",
    "recordedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": "automation-attempt-result@1.0.0" },
    "automationAttemptResultId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "workspaceId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "projectId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "automationAttemptId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "normalizationKind": { "enum": ["SCHEMA_VALIDATED", "SYNTHETIC_INCOMPLETE"] },
    "outcome": {
      "enum": ["PASS", "ASSERTION_FAILED", "INFRA_FAILED", "TIMEOUT", "CANCELLED", "INCOMPLETE"]
    },
    "resultSchemaRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/schemaRef" },
    "observedResultSchemaRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/schemaRef" },
    "sourceResultArtifactRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" },
    "normalizationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issueCodes", "reportHash"],
      "properties": {
        "status": { "enum": ["VALID", "INVALID", "MISSING"] },
        "issueCodes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TRIGGER_AMBIGUOUS",
              "PIPELINE_IDENTITY_MISSING",
              "RESULT_MISSING",
              "RESULT_TOO_LARGE",
              "RESULT_SCHEMA_UNKNOWN",
              "RESULT_SCHEMA_DRIFT",
              "RESULT_SCOPE_MISMATCH",
              "RESULT_TARGET_MISMATCH",
              "ARTIFACT_CHECKSUM_MISMATCH",
              "ARTIFACT_EXPIRED",
              "PROVIDER_STATUS_UNKNOWN"
            ]
          }
        },
        "reportHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" }
      }
    },
    "normalizedResultHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
    "externalPipelineId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "externalJobIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "mergeRequestRef", "commitSha"],
          "properties": {
            "type": { "const": "MERGE_REQUEST" },
            "mergeRequestRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" },
            "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "buildRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "commitSha"],
          "properties": {
            "type": { "const": "COMMIT" },
            "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "buildRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "buildRef", "commitSha"],
          "properties": {
            "type": { "const": "BUILD" },
            "buildRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" },
            "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          }
        }
      ]
    },
    "suiteKey": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "environmentRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "infrastructureCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "cancellationReasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "syntheticReasonCode": {
      "type": "string",
      "enum": [
        "TRIGGER_AMBIGUOUS",
        "PIPELINE_IDENTITY_MISSING",
        "RESULT_MISSING",
        "RESULT_TOO_LARGE",
        "RESULT_SCHEMA_UNKNOWN",
        "RESULT_SCHEMA_DRIFT",
        "RESULT_SCOPE_MISMATCH",
        "RESULT_TARGET_MISMATCH",
        "ARTIFACT_CHECKSUM_MISMATCH",
        "ARTIFACT_EXPIRED",
        "PROVIDER_STATUS_UNKNOWN"
      ]
    },
    "artifactDescriptorSetHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
    "artifactSyncState": { "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE", "EXPIRED"] },
    "terminalAt": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/timestamp" },
    "recordedAt": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/timestamp" },
    "contentHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "normalizationKind": { "const": "SCHEMA_VALIDATED" } },
        "required": ["normalizationKind"]
      },
      "then": {
        "required": [
          "sourceResultArtifactRef",
          "externalPipelineId",
          "externalJobIds",
          "target",
          "durationMs"
        ],
        "properties": {
          "sourceResultArtifactRef": {},
          "externalPipelineId": {},
          "externalJobIds": {},
          "target": {},
          "durationMs": {},
          "observedResultSchemaRef": false,
          "syntheticReasonCode": false,
          "normalizationReport": {
            "properties": {
              "status": { "const": "VALID" },
              "issueCodes": { "maxItems": 0 }
            }
          }
        }
      },
      "else": {
        "required": ["syntheticReasonCode"],
        "properties": {
          "outcome": { "const": "INCOMPLETE" },
          "normalizationReport": {
            "properties": {
              "status": { "enum": ["INVALID", "MISSING"] },
              "issueCodes": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "syntheticReasonCode": {
            "enum": ["RESULT_SCHEMA_UNKNOWN", "RESULT_SCHEMA_DRIFT"]
          }
        },
        "required": ["syntheticReasonCode"]
      },
      "then": {
        "required": ["observedResultSchemaRef", "sourceResultArtifactRef"],
        "properties": {
          "observedResultSchemaRef": {},
          "sourceResultArtifactRef": {}
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": ["PASS", "ASSERTION_FAILED", "TIMEOUT", "CANCELLED"]
          }
        },
        "required": ["outcome"]
      },
      "then": { "properties": { "infrastructureCode": false } }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "CANCELLED" } },
        "required": ["outcome"]
      },
      "then": { "required": ["cancellationReasonCode"] },
      "else": { "properties": { "cancellationReasonCode": false } }
    }
  ]
}
