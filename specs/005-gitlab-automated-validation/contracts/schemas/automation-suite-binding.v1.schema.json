{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:005:automation-suite-binding:v1",
  "title": "AutomationSuiteBinding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteBindingId",
    "workspaceId",
    "projectId",
    "suiteKey",
    "version",
    "state",
    "ownerPrincipalId",
    "suiteDefinition",
    "logicalExecutionContract",
    "allowedTargetTypes",
    "allowedEnvironmentRefs",
    "parameterSchemaRef",
    "resultSchemaRef",
    "artifactPolicyRef",
    "artifactPolicyHash",
    "retryPolicyRef",
    "retryPolicyHash",
    "quarantinePolicyRef",
    "quarantinePolicyHash",
    "capabilityRequirements",
    "contentHash",
    "resourceVersion",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "automation-suite-binding@1.0.0" },
    "suiteBindingId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "workspaceId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "projectId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "suiteKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "version": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "RETIRED"] },
    "ownerPrincipalId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "suiteDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "digest"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" }
      }
    },
    "logicalExecutionContract": {
      "description": "Provider-neutral pipeline/ref/result-job contract; the GitLab Profile maps these logical selectors to exact provider values.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipelineKey",
        "sourceRefPolicyRef",
        "resultJobKey",
        "contractHash"
      ],
      "properties": {
        "pipelineKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "sourceRefPolicyRef": {
          "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef"
        },
        "resultJobKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "contractHash": {
          "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash"
        }
      }
    },
    "allowedTargetTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["MERGE_REQUEST", "COMMIT", "BUILD"] }
    },
    "allowedEnvironmentRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" }
    },
    "parameterSchemaRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/schemaRef" },
    "resultSchemaRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/schemaRef" },
    "artifactPolicyRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" },
    "artifactPolicyHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
    "retryPolicyRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" },
    "retryPolicyHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
    "quarantinePolicyRef": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" },
    "quarantinePolicyHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
    "capabilityRequirements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "source-context.read@1.0.0",
          "test-executor.trigger-status@1.0.0",
          "artifact.ci-read@1.0.0"
        ]
      }
    },
    "validationReportId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "validationEvidenceHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
    "contentHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
    "resourceVersion": { "type": "integer", "minimum": 1 },
    "createdAt": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/timestamp" },
    "publishedAt": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/timestamp" },
    "retiredAt": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "enum": ["VALIDATED", "PUBLISHED", "RETIRED"] } },
        "required": ["state"]
      },
      "then": { "required": ["validationReportId", "validationEvidenceHash"] }
    },
    {
      "if": {
        "properties": { "state": { "const": "PUBLISHED" } },
        "required": ["state"]
      },
      "then": {
        "required": ["publishedAt"],
        "properties": {
          "publishedAt": {},
          "retiredAt": false
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "RETIRED" } },
        "required": ["state"]
      },
      "then": {
        "required": ["publishedAt", "retiredAt"],
        "properties": {
          "publishedAt": {},
          "retiredAt": {}
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "DRAFT" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "validationReportId": false,
          "validationEvidenceHash": false,
          "publishedAt": false,
          "retiredAt": false
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "VALIDATED" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "publishedAt": false,
          "retiredAt": false
        }
      }
    }
  ]
}
