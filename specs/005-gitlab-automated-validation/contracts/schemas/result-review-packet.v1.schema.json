{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:005:result-review-packet:v1",
  "title": "Automation result review packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceId",
    "projectId",
    "workItemId",
    "testSessionId",
    "attemptSetHash",
    "attempts",
    "artifactReferences",
    "findingDrafts",
    "flakySuspected",
    "quarantineWarnings",
    "unresolvedChecks",
    "proposalOnly",
    "generatedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": "result-review-packet@1.0.0" },
    "workspaceId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "projectId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "workItemId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "testSessionId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
    "attemptSetHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["automationAttemptId", "attemptNo", "outcome", "resultHash"],
        "properties": {
          "automationAttemptId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
          "attemptNo": { "type": "integer", "minimum": 1 },
          "outcome": {
            "enum": ["PASS", "ASSERTION_FAILED", "INFRA_FAILED", "TIMEOUT", "CANCELLED", "INCOMPLETE"]
          },
          "resultHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" }
        }
      }
    },
    "artifactReferences": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" }
    },
    "findingDrafts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "suggestedClassification", "evidenceRefs"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 256 },
          "suggestedClassification": {
            "enum": ["PRODUCT", "INFRA", "INCONCLUSIVE", "DUPLICATE", "ACCEPTED_RISK"]
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/nonEmptyRef" }
          }
        }
      }
    },
    "flakySuspected": { "type": "boolean" },
    "quarantineWarnings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quarantineId",
          "subject",
          "currentRevisionNo",
          "currentRevisionHash",
          "effectiveState"
        ],
        "properties": {
          "quarantineId": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/id" },
          "subject": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/automationQuarantineSubject" },
          "currentRevisionNo": { "type": "integer", "minimum": 1 },
          "currentRevisionHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" },
          "effectiveState": { "enum": ["ACTIVE", "EXPIRED"] }
        }
      }
    },
    "unresolvedChecks": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ATTEMPT_NONTERMINAL",
          "RETRY_DECISION_OPEN",
          "RECONCILIATION_INCOMPLETE",
          "ATTEMPT_SET_STALE",
          "FINDING_REVIEW_REQUIRED",
          "FLAKY_DISPOSITION_REQUIRED",
          "QUARANTINE_WARNING_UNDISPOSED",
          "RISK_REVIEW_REQUIRED"
        ]
      }
    },
    "proposalOnly": { "const": true },
    "generatedAt": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/timestamp" },
    "contentHash": { "$ref": "urn:awp:schemas:005:common:v1#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "quarantineWarnings": { "minItems": 1 } },
        "required": ["quarantineWarnings"]
      },
      "then": {
        "properties": {
          "unresolvedChecks": {
            "contains": { "const": "QUARANTINE_WARNING_UNDISPOSED" },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "unresolvedChecks": {
            "not": { "contains": { "const": "QUARANTINE_WARNING_UNDISPOSED" } }
          }
        }
      }
    }
  ]
}
