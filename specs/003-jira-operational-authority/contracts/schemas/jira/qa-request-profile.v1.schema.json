{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:jira:qa-request-profile:v1",
  "title": "Central Jira QA Request Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "logicalRole", "adapterFamily", "project", "issueType", "projectDiscriminatorFieldId", "effectMarkerFieldId", "createJqlScope", "importJqlScope", "mappingRef", "statusMappings", "priorityMappings", "identityPolicy", "operations", "transitionInputSchemaRef", "transitionMappings", "sourceLinkPolicy", "directImport", "webhook", "reconciliation", "rateBudget", "concurrency"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "logicalRole": { "const": "QA_REQUEST_AUTHORITY" },
    "adapterFamily": { "enum": ["jira-cloud-v3", "jira-dc-9-v2", "jira-dc-10-v2", "jira-dc-11-v2"] },
    "project": { "$ref": "#/$defs/IdName" },
    "issueType": { "$ref": "#/$defs/IdName" },
    "projectDiscriminatorFieldId": { "$ref": "#/$defs/CustomField" },
    "effectMarkerFieldId": { "$ref": "#/$defs/CustomField" },
    "createJqlScope": { "$ref": "#/$defs/FixedJql" },
    "importJqlScope": { "$ref": "#/$defs/FixedJql" },
    "mappingRef": { "$ref": "#/$defs/ContentRef" },
    "statusMappings": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/StatusMapping" } },
    "priorityMappings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/PriorityMapping" } },
    "identityPolicy": { "type": "object", "additionalProperties": false, "required": ["providerIdentityKind", "requesterMode"], "properties": { "providerIdentityKind": { "enum": ["CLOUD_ACCOUNT_ID", "DC_STABLE_USER_ID"] }, "requesterMode": { "enum": ["VERIFIED_REPORTER", "SERVICE_REPORTER_WITH_VERIFIED_REQUESTER_FIELD"] }, "requesterFieldId": { "$ref": "#/$defs/CustomField" } } },
    "operations": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["request.create", "request.transition", "request.assign", "request.set-priority", "request.set-due-date"] }, "allOf": [{ "contains": { "const": "request.create" } }, { "contains": { "const": "request.transition" } }] },
    "transitionInputSchemaRef": { "$ref": "#/$defs/ContentRef" },
    "transitionMappings": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["fromStatusId", "toNormalizedStatus", "transitionId"], "properties": { "fromStatusId": { "type": "string", "minLength": 1 }, "toNormalizedStatus": { "$ref": "#/$defs/NormalizedStatus" }, "transitionId": { "type": "string", "minLength": 1 } } } },
    "sourceLinkPolicy": { "type": "object", "additionalProperties": false, "required": ["requiredWhenSourcePresent", "auxiliaryLogicalRole", "crossAuthorityStrategy", "jiraLinkTypeId", "direction", "remoteGlobalIdPrefix"], "properties": { "requiredWhenSourcePresent": { "const": true }, "auxiliaryLogicalRole": { "const": "SOURCE_CONTEXT" }, "crossAuthorityStrategy": { "enum": ["NATIVE_SAME_AUTHORITY", "REMOTE_LINK"] }, "jiraLinkTypeId": { "type": "string", "minLength": 1 }, "direction": { "enum": ["INWARD", "OUTWARD"] }, "remoteGlobalIdPrefix": { "type": "string", "pattern": "^awp:[A-Za-z0-9._-]+:$" } } },
    "directImport": { "type": "object", "additionalProperties": false, "required": ["confirmationMode", "requireVerifiedCreator", "onUnverified"], "properties": { "confirmationMode": { "const": "VERIFIED_HUMAN_ISSUE_CREATE" }, "requireVerifiedCreator": { "const": true }, "onUnverified": { "const": "AWAITING_CONFIRMATION" } } },
    "webhook": { "$ref": "#/$defs/WebhookPolicy" },
    "reconciliation": { "$ref": "#/$defs/ReconciliationPolicy" },
    "rateBudget": { "$ref": "#/$defs/RateBudget" },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "safetyEvidenceRef"],
      "properties": {
        "mode": { "enum": ["JIRA_SIDE_CAS", "COMPARE_AND_VERIFY"] },
        "safetyEvidenceRef": { "$ref": "#/$defs/ContentRef" },
        "conditionalMutationCapabilityRef": { "$ref": "#/$defs/ContentRef" },
        "riskAcceptanceRef": { "$ref": "#/$defs/ContentRef" }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "JIRA_SIDE_CAS" } }, "required": ["mode"] }, "then": { "required": ["conditionalMutationCapabilityRef"] } },
        { "if": { "properties": { "mode": { "const": "COMPARE_AND_VERIFY" } }, "required": ["mode"] }, "then": { "required": ["riskAcceptanceRef"] } }
      ]
    }
  },
  "$defs": {
    "Digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ContentRef": { "type": "object", "additionalProperties": false, "required": ["id", "version", "contentHash"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "#/$defs/Digest" } } },
    "IdName": { "type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } } },
    "CustomField": { "type": "string", "pattern": "^customfield_[0-9]+$" },
    "FixedJql": { "type": "object", "additionalProperties": false, "required": ["templateKey", "contentHash"], "properties": { "templateKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" }, "contentHash": { "$ref": "#/$defs/Digest" } } },
    "NormalizedStatus": { "enum": ["NEW", "NEEDS_INFO", "READY", "PLANNED", "IN_PROGRESS", "REVIEW", "BLOCKED", "DONE", "CANCELLED"] },
    "StatusMapping": { "type": "object", "additionalProperties": false, "required": ["rawStatusId", "rawStatusName", "normalizedStatus"], "properties": { "rawStatusId": { "type": "string", "minLength": 1 }, "rawStatusName": { "type": "string", "minLength": 1 }, "normalizedStatus": { "$ref": "#/$defs/NormalizedStatus" } } },
    "PriorityMapping": { "type": "object", "additionalProperties": false, "required": ["priorityId", "priorityName", "normalizedKey"], "properties": { "priorityId": { "type": "string", "minLength": 1 }, "priorityName": { "type": "string", "minLength": 1 }, "normalizedKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" } } },
    "WebhookPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrationKind", "verificationMode", "deliveryIdentityMode", "retryHorizonSeconds", "dedupeHorizonSeconds"],
      "properties": {
        "registrationKind": { "enum": ["ADMIN_STATIC", "DYNAMIC_REFRESHED", "LOCAL_FAKE"] },
        "verificationMode": { "enum": ["HMAC", "OPAQUE_PATH_SECRET_AND_DEDUPE", "LOCAL_HMAC"] },
        "deliveryIdentityMode": { "enum": ["CLOUD_HEADER", "CHANGELOG_TUPLE", "CANONICAL_PAYLOAD_HASH"] },
        "secretRotationPolicyRef": { "$ref": "#/$defs/ContentRef" },
        "retryHorizonSeconds": { "type": "integer", "minimum": 60, "maximum": 1209600 },
        "dedupeHorizonSeconds": { "type": "integer", "minimum": 60, "maximum": 2592000 },
        "expirySeconds": { "type": "integer", "minimum": 300, "maximum": 2592000 },
        "renewalLeadSeconds": { "type": "integer", "minimum": 60, "maximum": 604800 },
        "bootstrapCredentialRef": { "$ref": "#/$defs/ContentRef" }
      },
      "allOf": [
        { "if": { "properties": { "registrationKind": { "const": "DYNAMIC_REFRESHED" } }, "required": ["registrationKind"] }, "then": { "required": ["expirySeconds", "renewalLeadSeconds", "bootstrapCredentialRef"] } }
      ]
    },
    "ReconciliationPolicy": { "type": "object", "additionalProperties": false, "required": ["freshnessTargetSeconds", "webhookGraceSeconds", "pollIntervalSeconds", "fullSweepIntervalSeconds", "overlapSeconds", "pageSize", "maxConcurrency"], "properties": { "freshnessTargetSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 }, "webhookGraceSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 }, "pollIntervalSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 }, "fullSweepIntervalSeconds": { "type": "integer", "minimum": 300, "maximum": 604800 }, "overlapSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }, "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 }, "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 16 } } },
    "RateBudget": { "type": "object", "additionalProperties": false, "required": ["windowSeconds", "maxRequests", "burst", "maxInFlight", "maxRetryAfterSeconds"], "properties": { "windowSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }, "maxRequests": { "type": "integer", "minimum": 1, "maximum": 100000 }, "burst": { "type": "integer", "minimum": 1, "maximum": 1000 }, "maxInFlight": { "type": "integer", "minimum": 1, "maximum": 64 }, "maxRetryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 } } }
  }
}
