{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:jira:secret-lease:v1",
  "title": "Non-serializable Secret Lease Metadata",
  "description": "Serializable metadata only. Secret material exists solely inside the in-memory resolver lease and is forbidden from persistence, logs, events and API payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "leaseId", "secretRefHash", "secretVersionRef", "allowedUseHash", "issuedAt", "expiresAt", "redactionToken"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "leaseId": { "type": "string", "format": "uuid" },
    "secretRefHash": { "$ref": "#/$defs/Digest" },
    "secretVersionRef": { "type": "string", "minLength": 1, "maxLength": 255 },
    "allowedUseHash": { "$ref": "#/$defs/Digest" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "redactionToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }
  },
  "$defs": {
    "Digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
