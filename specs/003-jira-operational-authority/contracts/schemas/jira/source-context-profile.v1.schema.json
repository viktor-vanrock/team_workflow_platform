{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:jira:source-context-profile:v1",
  "title": "Read-only Jira Source Context Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "logicalRole", "projects", "issueTypeIds", "readJqlScope", "jiraLinkTypes", "remoteLinkGlobalIdPrefixes", "allowedFields", "rateBudgetRef"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "logicalRole": { "const": "SOURCE_CONTEXT" },
    "projects": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "issueTypeIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "readJqlScope": { "type": "object", "additionalProperties": false, "required": ["templateKey", "contentHash"], "properties": { "templateKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" }, "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } },
    "jiraLinkTypes": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["id", "direction"], "properties": { "id": { "type": "string", "minLength": 1 }, "direction": { "enum": ["INWARD", "OUTWARD"] } } } },
    "remoteLinkGlobalIdPrefixes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^awp:[A-Za-z0-9._-]+:$" } },
    "allowedFields": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
    "rateBudgetRef": { "$ref": "#/$defs/ContentRef" }
  },
  "$defs": {
    "Digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ContentRef": { "type": "object", "additionalProperties": false, "required": ["id", "version", "contentHash"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "#/$defs/Digest" } } }
  }
}
