{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:jira:defect-profile:v1",
  "title": "Jira Defect Destination Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "logicalRole", "project", "issueType", "effectMarkerFieldId", "mappingRef", "requiredFieldIds", "allowedFieldIds", "exactReplayJql", "duplicateCandidatePolicy", "qaRequestLink", "rateBudgetRef", "writeApprovalPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "logicalRole": { "const": "DEFECT_DESTINATION" },
    "project": { "$ref": "#/$defs/IdName" },
    "issueType": { "$ref": "#/$defs/IdName" },
    "effectMarkerFieldId": { "type": "string", "pattern": "^customfield_[0-9]+$" },
    "mappingRef": { "$ref": "#/$defs/ContentRef" },
    "requiredFieldIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/FieldId" } },
    "allowedFieldIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/FieldId" } },
    "exactReplayJql": { "$ref": "#/$defs/FixedJql" },
    "duplicateCandidatePolicy": { "type": "object", "additionalProperties": false, "required": ["mode", "queryTemplateKey", "maximumCandidates"], "properties": { "mode": { "const": "HUMAN_DECISION_ONLY" }, "queryTemplateKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" }, "maximumCandidates": { "type": "integer", "minimum": 1, "maximum": 50 } } },
    "qaRequestLink": { "type": "object", "additionalProperties": false, "required": ["auxiliaryLogicalRole", "crossAuthorityStrategy", "linkTypeId", "direction", "required"], "properties": { "auxiliaryLogicalRole": { "const": "QA_REQUEST_AUTHORITY" }, "crossAuthorityStrategy": { "enum": ["NATIVE_SAME_AUTHORITY", "REMOTE_LINK"] }, "linkTypeId": { "type": "string", "minLength": 1 }, "direction": { "enum": ["INWARD", "OUTWARD"] }, "required": { "const": true } } },
    "rateBudgetRef": { "$ref": "#/$defs/ContentRef" },
    "writeApprovalPolicy": { "const": "EXACT_EXTERNAL_COMMAND" }
  },
  "$defs": {
    "Digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ContentRef": { "type": "object", "additionalProperties": false, "required": ["id", "version", "contentHash"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "#/$defs/Digest" } } },
    "IdName": { "type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } } },
    "FieldId": { "type": "string", "pattern": "^(summary|description|priority|labels|customfield_[0-9]+)$" },
    "FixedJql": { "type": "object", "additionalProperties": false, "required": ["templateKey", "contentHash"], "properties": { "templateKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" }, "contentHash": { "$ref": "#/$defs/Digest" } } }
  }
}
