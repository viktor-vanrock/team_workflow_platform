{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:operational-work-item:defect-create:v1",
  "title": "Create Operational Defect Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceWorkItemId", "findingId", "defectDraftRef", "title", "description", "stepsToReproduce", "expectedOutcome", "actualOutcome", "severity", "targetSnapshotHash", "evidenceRefs", "dataClassificationKey"],
  "properties": {
    "sourceWorkItemId": { "type": "string", "format": "uuid" },
    "findingId": { "type": "string", "format": "uuid" },
    "defectDraftRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "description": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "stepsToReproduce": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "expectedOutcome": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "actualOutcome": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "targetSnapshotHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ArtifactRef" } },
    "dataClassificationKey": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ClassificationKey" }
  }
}

