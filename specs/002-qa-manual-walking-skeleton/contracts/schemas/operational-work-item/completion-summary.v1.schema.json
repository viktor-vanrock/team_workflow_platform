{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:operational-work-item:completion-summary:v1",
  "title": "Deterministic Provider-neutral QA Completion Summary",
  "description": "Closed, hash-covered content rendered by an operational Connector as the external completion comment. Links are platform-relative and never provider locators or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scopeSummary", "scopeSnapshotRefs", "verdict", "verdictRef", "residualRisk", "evidenceReferences", "defectReferences"],
  "properties": {
    "scopeSummary": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "scopeSnapshotRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableContentRef" }
    },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"] },
    "verdictRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef" },
    "residualRisk": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/EvidenceReference" }
    },
    "defectReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/DefectReference" }
    }
  },
  "$defs": {
    "EvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestRevisionRef", "displayLabel", "platformPath"],
      "properties": {
        "manifestRevisionRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef" },
        "displayLabel": { "type": "string", "minLength": 1, "maxLength": 500 },
        "platformPath": { "type": "string", "format": "uri-reference", "pattern": "^/", "maxLength": 2000 }
      }
    },
    "DefectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingReviewRef", "dispositionDecision", "publicationOutcome", "defectDraftRefs", "defectLinkIds", "displayLabel", "platformPath"],
      "properties": {
        "findingReviewRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef" },
        "dispositionDecision": { "type": "string", "enum": ["CREATE_DEFECT", "DUPLICATE", "NOT_A_BUG", "ACCEPTED_RISK", "DEFERRED", "WAIVED"] },
        "publicationOutcome": { "type": "string", "enum": ["LINKED", "REJECTED", "NOT_APPLICABLE"] },
        "defectDraftRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef" }
        },
        "defectLinkIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "rejectionRef": {
          "description": "Exact append-only rejected DefectDraft projection; semantic equality requires this ref to equal the sole defectDraftRefs member.",
          "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef"
        },
        "duplicateDefectRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ExternalImmutableRef" },
        "dispositionReason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "displayLabel": { "type": "string", "minLength": 1, "maxLength": 500 },
        "platformPath": { "type": "string", "format": "uri-reference", "pattern": "^/", "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": { "properties": { "dispositionDecision": { "const": "CREATE_DEFECT" } }, "required": ["dispositionDecision"] },
          "then": {
            "properties": { "defectDraftRefs": { "minItems": 1, "maxItems": 1 } },
            "oneOf": [
              {
                "properties": { "publicationOutcome": { "const": "LINKED" }, "defectLinkIds": { "minItems": 1, "maxItems": 1 } },
                "not": { "required": ["rejectionRef"] }
              },
              {
                "properties": { "publicationOutcome": { "const": "REJECTED" }, "defectLinkIds": { "maxItems": 0 } },
                "required": ["rejectionRef", "dispositionReason"]
              }
            ],
            "not": { "required": ["duplicateDefectRef"] }
          },
          "else": {
            "properties": { "publicationOutcome": { "const": "NOT_APPLICABLE" }, "defectDraftRefs": { "maxItems": 0 }, "defectLinkIds": { "maxItems": 0 } },
            "not": { "required": ["rejectionRef"] }
          }
        },
        {
          "if": { "properties": { "dispositionDecision": { "const": "DUPLICATE" } }, "required": ["dispositionDecision"] },
          "then": { "required": ["duplicateDefectRef", "dispositionReason"] },
          "else": { "not": { "required": ["duplicateDefectRef"] } }
        }
      ]
    },
    "Receipt": {
      "description": "Sanitized proof that the same hash-covered summary was materialized by the external completion effect/read-back; no provider response body is retained.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summaryHash", "externalReceiptId", "externalReceiptVersion", "observedAt"],
      "properties": {
        "summaryHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
        "externalReceiptId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "externalReceiptVersion": { "type": "string", "minLength": 1, "maxLength": 255 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
