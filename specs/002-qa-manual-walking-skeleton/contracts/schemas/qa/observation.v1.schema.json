{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:qa:observation:v1",
  "title": "Append-only Manual QA Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observationId", "workspaceId", "projectId", "workItemId", "sessionId", "planItemId", "attemptId", "kind", "expectedOutcome", "actualOutcome", "severity", "actor", "observedAt", "contentHash", "resourceVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "workItemId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "planItemId": { "type": "string", "format": "uuid" },
    "attemptId": { "type": "string", "format": "uuid" },
    "kind": { "type": "string", "enum": ["POSITIVE", "NEGATIVE", "AMBIGUOUS", "INFORMATIONAL"] },
    "expectedOutcome": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "actualOutcome": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "severity": { "type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "notes": { "type": "string", "maxLength": 4000 },
    "artifactRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ArtifactRef" } },
    "correctsObservationRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableContentRef" },
    "correctionReason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "actor": { "$ref": "../common/qa-common.v1.schema.json#/$defs/HumanActorRef" },
    "observedAt": { "type": "string", "format": "date-time" },
    "contentHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
    "resourceVersion": { "type": "integer", "minimum": 1 }
  },
  "dependentRequired": {
    "correctsObservationRef": ["correctionReason"],
    "correctionReason": ["correctsObservationRef"]
  }
}
