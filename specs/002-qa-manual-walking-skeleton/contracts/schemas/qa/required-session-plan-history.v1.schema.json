{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:qa:required-session-plan-history:v1",
  "title": "Scoped Required Session Plan History Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "projectId", "workItemId", "planId", "currentRevisionRef", "resourceVersion", "frozenAt", "revisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspaceId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "workItemId": { "type": "string", "format": "uuid" },
    "planId": { "type": "string", "format": "uuid" },
    "currentRevisionRef": {
      "description": "Null only for the stable empty bootstrap header before the first publication.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "../common/qa-common.v1.schema.json#/$defs/RequiredSessionPlanRef" }
      ]
    },
    "resourceVersion": { "type": "integer", "minimum": 1 },
    "frozenAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
    "revisions": {
      "type": "array",
      "items": { "$ref": "./required-session-plan.v1.schema.json" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "currentRevisionRef": { "type": "null" } }, "required": ["currentRevisionRef"] },
      "then": {
        "properties": { "revisions": { "maxItems": 0 }, "frozenAt": { "type": "null" } }
      },
      "else": { "properties": { "revisions": { "minItems": 1 } } }
    }
  ]
}
