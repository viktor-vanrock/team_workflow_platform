{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:qa:defect-link:v1",
  "title": "Confirmed External Defect Link",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defectLinkId", "workspaceId", "projectId", "workItemId", "sessionId", "findingId", "frozenFindingReviewRef", "defectDraftRef", "commandRef", "approvalRef", "confirmationReceiptRef", "operationalResultRef", "effectKeyHash", "externalEntityId", "externalDisplayKey", "externalVersion", "rawExternalState", "normalizedStatus", "bindingRef", "profileRefs", "confirmedBy", "authorizationBasisHash", "linkedAt", "correlationId", "causationId", "contentHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defectLinkId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "workItemId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "findingId": { "type": "string", "format": "uuid" },
    "frozenFindingReviewRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef" },
    "defectDraftRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef" },
    "commandRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/GenericCommandRef" },
    "approvalRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/GenericApprovalRef" },
    "confirmationReceiptRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/UuidRef" },
    "operationalResultRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/UuidRef" },
    "effectKeyHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
    "externalEntityId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "externalDisplayKey": { "type": "string", "minLength": 1, "maxLength": 255 },
    "externalVersion": { "type": "string", "minLength": 1, "maxLength": 255 },
    "rawExternalState": { "type": "string", "minLength": 1, "maxLength": 128 },
    "normalizedStatus": { "const": "NEW" },
    "bindingRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/BindingRef" },
    "profileRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ProfileRef" } },
    "confirmedBy": { "$ref": "../common/qa-common.v1.schema.json#/$defs/HumanActorRef" },
    "authorizationBasisHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
    "linkedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "contentHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" }
  }
}
