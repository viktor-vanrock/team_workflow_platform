{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:qa:target-snapshot:v1",
  "title": "Immutable QA Target Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetSnapshotId", "workspaceId", "projectId", "projectContextRef", "buildRef", "environment", "testDataRef", "accountLeaseRef", "checklistRefs", "bindingRef", "profileRefs", "contentHash", "capturedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetSnapshotId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "projectContextRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef" },
    "buildRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ExternalImmutableRef" },
    "mergeRequestRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ExternalImmutableRef" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentId", "revision", "scope"],
      "properties": {
        "environmentId": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string", "enum": ["LOCAL", "NON_PROD", "PREPROD"] }
      }
    },
    "testDataRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ExternalImmutableRef" },
    "accountLeaseRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ExternalImmutableRef" },
    "checklistRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ExternalImmutableRef" } },
    "bindingRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/BindingRef" },
    "profileRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ProfileRef" } },
    "contentHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
    "capturedAt": { "type": "string", "format": "date-time" }
  }
}
