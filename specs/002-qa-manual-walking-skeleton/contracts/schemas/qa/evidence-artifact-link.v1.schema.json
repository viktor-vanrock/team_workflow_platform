{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:qa:evidence-artifact-link:v1",
  "title": "Scoped QA Evidence Artifact Link",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceArtifactLinkId", "workspaceId", "projectId", "workItemId", "sessionId", "artifactRef", "owner", "mediaType", "sizeBytes", "availability", "finalizedAt", "capturedBy", "capturedAt", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceArtifactLinkId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "workItemId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "artifactRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ArtifactRef" },
    "displayLabel": {
      "description": "Non-normative presentation text. It is excluded from adjudication and may be clerically corrected after close.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownerType", "ownerId"],
          "properties": {
            "ownerType": { "const": "SESSION" },
            "ownerId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownerType", "ownerId"],
          "properties": {
            "ownerType": { "type": "string", "enum": ["PLAN_ITEM", "ATTEMPT", "OBSERVATION", "FINDING"] },
            "ownerId": { "type": "string", "format": "uuid" }
          }
        }
      ]
    },
    "mediaType": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$", "maxLength": 127 },
    "sizeBytes": { "type": "integer", "minimum": 0 },
    "availability": { "type": "string", "enum": ["AVAILABLE", "EXPIRED"] },
    "finalizedAt": { "type": "string", "format": "date-time" },
    "capturedBy": { "$ref": "../common/qa-common.v1.schema.json#/$defs/HumanActorRef" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "expiredAt": { "type": "string", "format": "date-time" },
    "signedManifestMemberRefs": {
      "description": "Exact immutable manifest-member snapshots that have already pinned this link. Their content hashes never change when current availability changes.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableContentRef" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "captureMethod"],
      "properties": {
        "source": { "type": "string", "enum": ["MANUAL_UPLOAD", "SCREENSHOT", "LOG_EXPORT", "EXTERNAL_REFERENCE"] },
        "captureMethod": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "availability": { "const": "EXPIRED" } }, "required": ["availability"] },
      "then": { "required": ["expiredAt"] },
      "else": { "not": { "required": ["expiredAt"] } }
    }
  ]
}
