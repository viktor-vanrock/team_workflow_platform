{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:qa:request-input-history:v1",
  "title": "Scoped QA Request Input History Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "projectId", "workItemId", "extensionId", "currentInputRevisionRef", "resourceVersion", "revisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspaceId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "workItemId": { "type": "string", "format": "uuid" },
    "extensionId": { "type": "string", "format": "uuid" },
    "currentInputRevisionRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/QaRequestInputRevisionRef" },
    "resourceVersion": { "type": "integer", "minimum": 1 },
    "revisions": { "type": "array", "minItems": 1, "items": { "$ref": "./qa-request-input-revision.v1.schema.json" } }
  }
}
