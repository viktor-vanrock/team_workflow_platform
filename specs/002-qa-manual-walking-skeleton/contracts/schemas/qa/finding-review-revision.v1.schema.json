{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:qa:finding-review-revision:v1",
  "title": "Append-only Human Finding Review Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "findingReviewRevisionId", "version", "stage", "workspaceId", "projectId", "workItemId", "sessionId", "findingId", "classification", "severity", "summary", "affectedTargetHash", "classificationActor", "classificationReason", "classificationAt", "activeMembershipSetHash", "observationMembershipIds", "evidenceRefHash", "policyRef", "contentHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "findingReviewRevisionId": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "stage": { "type": "string", "enum": ["CLASSIFIED", "DISPOSED", "FROZEN"] },
    "previousRevisionRef": {
      "description": "Exact immediately preceding revision of this same Finding review aggregate. Version 1 is CLASSIFIED and has no predecessor. Later CLASSIFIED revisions represent reclassification; DISPOSED must succeed CLASSIFIED and FROZEN must succeed DISPOSED, enforced by same-scope semantic validation.",
      "$ref": "../common/qa-common.v1.schema.json#/$defs/ImmutableRevisionRef"
    },
    "workspaceId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "workItemId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "findingId": { "type": "string", "format": "uuid" },
    "classification": { "type": "string", "enum": ["PRODUCT", "INFRA", "INCONCLUSIVE", "DUPLICATE", "ACCEPTED_RISK"] },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "affectedTargetHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
    "classificationActor": { "$ref": "../common/qa-common.v1.schema.json#/$defs/HumanActorRef" },
    "classificationReason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "classificationAt": { "type": "string", "format": "date-time" },
    "dispositionDecision": { "type": "string", "enum": ["CREATE_DEFECT", "DUPLICATE", "NOT_A_BUG", "ACCEPTED_RISK", "DEFERRED", "WAIVED"] },
    "dispositionActor": { "$ref": "../common/qa-common.v1.schema.json#/$defs/HumanActorRef" },
    "dispositionReason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "dispositionAt": { "type": "string", "format": "date-time" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "duplicateDefectRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/ExternalImmutableRef" },
    "acceptedRiskActionRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/GenericPlatformActionRef" },
    "waiverActionRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/GenericPlatformActionRef" },
    "activeMembershipSetHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
    "observationMembershipIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
    "evidenceRefHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" },
    "policyRef": { "$ref": "../common/qa-common.v1.schema.json#/$defs/SemanticRef" },
    "contentHash": { "$ref": "../common/qa-common.v1.schema.json#/$defs/Digest" }
  },
  "allOf": [
    { "if": { "properties": { "version": { "minimum": 2 } }, "required": ["version"] }, "then": { "required": ["previousRevisionRef"] }, "else": { "not": { "required": ["previousRevisionRef"] } } },
    {
      "if": { "properties": { "version": { "const": 1 } }, "required": ["version"] },
      "then": { "properties": { "stage": { "const": "CLASSIFIED" } } }
    },
    {
      "if": { "properties": { "stage": { "enum": ["DISPOSED", "FROZEN"] } }, "required": ["stage"] },
      "then": {
        "properties": { "version": { "minimum": 2 } },
        "required": ["previousRevisionRef"]
      }
    },
    { "if": { "properties": { "stage": { "enum": ["DISPOSED", "FROZEN"] } }, "required": ["stage"] }, "then": { "required": ["dispositionDecision", "dispositionActor", "dispositionReason", "dispositionAt"] }, "else": { "allOf": [{ "not": { "required": ["dispositionDecision"] } }, { "not": { "required": ["dispositionActor"] } }, { "not": { "required": ["dispositionReason"] } }, { "not": { "required": ["dispositionAt"] } }] } },
    { "if": { "properties": { "stage": { "const": "FROZEN" } }, "required": ["stage"] }, "then": { "required": ["frozenAt"] }, "else": { "not": { "required": ["frozenAt"] } } },
    { "if": { "properties": { "classification": { "const": "PRODUCT" } }, "required": ["classification"] }, "then": { "properties": { "dispositionDecision": { "enum": ["CREATE_DEFECT", "DEFERRED", "WAIVED"] } } } },
    { "if": { "properties": { "classification": { "const": "INFRA" } }, "required": ["classification"] }, "then": { "properties": { "dispositionDecision": { "enum": ["NOT_A_BUG", "DEFERRED", "WAIVED"] } } } },
    { "if": { "properties": { "classification": { "const": "INCONCLUSIVE" } }, "required": ["classification"] }, "then": { "properties": { "dispositionDecision": { "enum": ["DEFERRED", "WAIVED"] } } } },
    { "if": { "properties": { "classification": { "const": "DUPLICATE" } }, "required": ["classification"] }, "then": { "properties": { "dispositionDecision": { "const": "DUPLICATE" } } } },
    { "if": { "properties": { "classification": { "const": "ACCEPTED_RISK" } }, "required": ["classification"] }, "then": { "properties": { "dispositionDecision": { "const": "ACCEPTED_RISK" } } } },
    { "if": { "properties": { "dispositionDecision": { "const": "DUPLICATE" } }, "required": ["dispositionDecision"] }, "then": { "required": ["duplicateDefectRef", "dispositionReason"] }, "else": { "not": { "required": ["duplicateDefectRef"] } } },
    { "if": { "properties": { "dispositionDecision": { "const": "ACCEPTED_RISK" } }, "required": ["dispositionDecision"] }, "then": { "required": ["acceptedRiskActionRef"] }, "else": { "not": { "required": ["acceptedRiskActionRef"] } } },
    { "if": { "properties": { "dispositionDecision": { "const": "WAIVED" } }, "required": ["dispositionDecision"] }, "then": { "required": ["waiverActionRef"] }, "else": { "not": { "required": ["waiverActionRef"] } } }
  ]
}
