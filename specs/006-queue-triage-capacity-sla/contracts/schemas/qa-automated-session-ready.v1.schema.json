{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awp:schemas:qa:event-payload:automated-session-ready:v1",
  "title": "QA Automated Session Ready payload v1",
  "$comment": "Physical schema for the already-emitted qa.automated-session.ready outbox payload. Session and Work Item identities are UUIDs so the canonical EventEnvelope entityId can equal sessionId; referenced binding IDs retain their existing bounded opaque form. Workspace and Project scope remain in the canonical EventEnvelope. Registration under competency-qa@1.3.0 adds an exact declaration without rewriting historical events or the 1.2.0 manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "workItemId",
    "mode",
    "state",
    "suiteBindingRef",
    "targetSnapshotHash",
    "scopeSnapshotHash",
    "configurationPinSetHash"
  ],
  "properties": {
    "sessionId": { "$ref": "#/$defs/id" },
    "workItemId": { "$ref": "#/$defs/id" },
    "mode": { "const": "AUTOMATED" },
    "state": { "const": "READY" },
    "suiteBindingRef": { "$ref": "#/$defs/exactRef" },
    "targetSnapshotHash": { "$ref": "#/$defs/hash" },
    "scopeSnapshotHash": { "$ref": "#/$defs/hash" },
    "configurationPinSetHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "refId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contentHash"],
      "properties": {
        "id": { "$ref": "#/$defs/refId" },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
