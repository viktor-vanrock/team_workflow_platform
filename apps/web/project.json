{
  "name": "web",
  "root": "apps/web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["type:app", "runtime:browser", "domain:platform"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/web/tsconfig.json --noEmit" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "vite build --config apps/web/vite.config.ts" }
    },
    "qa-local-typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/web/tsconfig.json --noEmit" }
    },
    "qa-local-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VITE_AWP_COMPOSITION=qa-local vite build --config apps/web/vite.config.ts"
      }
    }
  }
}
