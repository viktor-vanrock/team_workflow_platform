{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dev runtime bootstrap v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deploymentPolicy", "configurations", "deployments"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deploymentPolicy": {
      "type": "object"
    },
    "configurations": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedRowVersion", "publication"],
        "properties": {
          "expectedRowVersion": {
            "type": "integer",
            "minimum": 0
          },
          "publication": {
            "type": "object"
          }
        }
      }
    },
    "deployments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedRowVersion", "record"],
        "properties": {
          "expectedRowVersion": {
            "type": "integer",
            "minimum": 0
          },
          "record": {
            "type": "object"
          }
        }
      }
    }
  }
}
